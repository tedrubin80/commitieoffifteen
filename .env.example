# Copy to .env — never commit .env (public repo)

# NYPL Digital Collections API (crawl only — get from api.repo.nypl.org)
NYPL_API_TOKEN=
NYPL_API_BASE=https://api.repo.nypl.org
NYPL_API_BUDGET=10000
COLLECTION_UUID=216eff30-6f84-0133-9b03-00505686d14e

# Vercel Postgres (web app — set in Vercel dashboard only)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Geocoding (Railway worker — set in Railway dashboard only)
NYC_GEOCLIENT_APP_ID=
NYC_GEOCLIENT_APP_KEY=
MAPBOX_TOKEN=

# Optional: HF/Kaggle upload (local CLI only — never in repo)
# HF_TOKEN=          # huggingface-cli login
# KAGGLE_USERNAME=   # ~/.kaggle/kaggle.json
