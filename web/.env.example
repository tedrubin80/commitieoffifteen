# Prisma (Vercel Postgres / Neon integration)
# Pooled URL for the app (Prisma Client). Prefer DATABASE_URL from Prisma/Vercel.
DATABASE_URL=

# Direct (non-pooling) URL for prisma migrate / db push
# Often the same as POSTGRES_URL_NON_POOLING from Vercel Postgres
DIRECT_URL=

# Optional aliases (app also accepts these if DATABASE_URL unset)
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=

NEXT_PUBLIC_APP_URL=
